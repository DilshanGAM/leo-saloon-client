// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id String @id @default(uuid())
  email String @unique
  phone String? @unique
  firstName String
  lastName String
  password String
  role String @default("CUSTOMER")
  status String @default("ACTIVE") // ACTIVE, BANNED, SUSPENDED
  createdAt DateTime @default(now())
  lastLogin DateTime?
  privileges String[] @default([])//  "users:add",  "users:edit",  "users.read"
  profileImage String @default("/images/default-profile.png")
  orders Order[]
  paymentsMade Payment[] @relation("PaymentPaidBy")
  paymentsReviewed Payment[] @relation("PaymentReviewedBy")
  appointmentsPlaced Appointment[] @relation("AppointmentPlacedBy")
  appointmentsAssigned Appointment[] @relation("AppointmentAssignedTo")
  appointmentsDone Appointment[] @relation("AppointmentDoneBy")

  approvedLeaves Leave[] @relation("LeaveApprovedBy")
  leaves Leave[] @relation("LeaveUser")
  emailOTP emailOTP[]
  cart Cart?
} //gender, emailVerified, phoneVerified

enum ProductStatus {
  ACTIVE
  INACTIVE
  DELETED
}

model Product{
  id String @id @default(uuid())
  sku String @unique
  name String
  altNames String[] @default([])
  description String
  stock Int @default(0)
  // status String @default("ACTIVE") // ACTIVE, INACTIVE, DISCONTINUED
  status ProductStatus @default(ACTIVE)
  price Float
  compareAt Float?
  brand String?
  model String?
  media Media[]
  orderItems OrderItem[]
}

enum MediaType {
  IMAGE
  VIDEO
}

model Media{
  id String @id @default(uuid())
  url String 
  type MediaType
  productId String?
  product Product? @relation(fields : [productId], references: [id])
  serviceId String?
  service Service? @relation(fields : [serviceId], references: [id])
  variantId String?
  variant Variant? @relation(fields : [variantId], references: [id])

}

enum OrderDeliveryStatus {
  PENDING
  DELIVERED
  CANCELLED
  RETURNED
}

model Order{
  id Int @id @default(autoincrement())
  date DateTime @default(now())
  deliveredStatus OrderDeliveryStatus @default(PENDING)
  placedByUserId String
  placedBy User @relation(fields: [placedByUserId], references: [id])
  payment Payment?
  totalAmount Decimal//Derived Attribute

  orderItems OrderItem[]
  notes String?

  orderTotalAdjustments OrderTotalAdjustment[]
}

model OrderItem{
  id String @id @default(uuid())
  orderId Int
  productId String
  name String
  price Decimal
  compareAt Decimal?
  quantity Int
  
  order Order @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model OrderTotalAdjustment{

  id String @id @default(uuid())
  orderId Int
  description String
  amount Decimal

  order Order @relation(fields: [orderId], references: [id])
}



enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod{
  CARD
  BANK_TRANSFER
  CASH_ON_DELIVERY
  CASH
}

model Payment{

  id String @id @default(uuid())
  number Int @unique @default(autoincrement())
  amount Decimal
  orderId Int? @unique
  appointmentId Int? @unique
  reference String? @unique @default(uuid())
  
  status PaymentStatus @default(PENDING)
  paidByUserId String?
  reviewedByUserId String?

  method PaymentMethod @default(CARD)
  fee Decimal @default(0.00)
  createdAt DateTime @default(now())
  receivedAt DateTime?

  order Order? @relation(fields: [orderId], references: [id])
  paidBy User? @relation("PaymentPaidBy", fields: [paidByUserId], references: [id])
  reviewedBy User? @relation("PaymentReviewedBy", fields: [reviewedByUserId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
}

enum ServiceCategory{
  HAIR
  NAILS
  SKIN
  MASSAGE
  MALE
  FEMALE
  WEDDING
}

enum ServiceStatus{
  ACTIVE
  INACTIVE
  DISCONTINUED
}
model Service{
  id String @id @default(uuid())
  name String
  description String
  price Decimal
  estimatedTimeInMinutes Int
  categories ServiceCategory[]
  status ServiceStatus @default(ACTIVE)
  variants Variant[]
  priorConsultationRequired Boolean @default(false)
  media Media[]
}

model Variant{
  id String @id @default(uuid())
  name String
  priorConsultationRequired Boolean @default(false)
  media Media[]
  price Decimal
  serviceId String
  service Service @relation(fields: [serviceId], references: [id])
}

enum AppointmentStatus{
  PENDING
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Appointment{
  
  id Int @id @default(autoincrement())
  placedOn DateTime @default(now())
  status AppointmentStatus @default(PENDING)

  paymentId String? @unique

  placedByUserId String
  assignedToUserId String
  doneByUserId String?

  startTime DateTime
  endTime DateTime
  totalAmount Decimal
  notes String?
  
  payment Payment?
  appointmentTotalAdjustments AppointmentTotalAdjustment[]

  placedBy User @relation("AppointmentPlacedBy", fields: [placedByUserId], references: [id])
  assignedTo User @relation("AppointmentAssignedTo", fields: [assignedToUserId], references: [id])
  doneBy User? @relation("AppointmentDoneBy", fields: [doneByUserId], references: [id])
  appointmentServices AppointmentService[]

}

model AppointmentTotalAdjustment{

  id String @id @default(uuid())
  appointmentId Int
  description String


  appointment Appointment @relation(fields: [appointmentId], references: [id])
  

}




model AppointmentService{

  id String @id @default(uuid())
  appointmentId Int
  serviceId String

  price Decimal
  name String

  appointment Appointment @relation(fields: [appointmentId], references: [id])
}

enum LeaveStatus{
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}
model Leave{

  id String @id @default(uuid())
  userId String
  approverId String?
  startDate DateTime
  endDate DateTime
  reason String
  leaveStatus LeaveStatus @default(PENDING)

  approver User? @relation("LeaveApprovedBy", fields: [approverId], references: [id])
  user User @relation("LeaveUser",fields: [userId], references: [id])
  
}

model Holiday{

  id String @id @default(uuid())
  name String
  date DateTime

}

enum OTPType{
  FORGET_PASSWORD
  EMAIL_VERIFICATION
  ORDER_CONFIRMATION
}
model emailOTP{

  id String @id @default(uuid())
  userId String
  email String
  otp String
  isUsed Boolean @default(false)
  expiresAt DateTime
  type OTPType
  user User @relation(fields: [userId], references: [id])

}


model Cart{
  id String @id @default(uuid())
  
  userId String? @unique

  user User? @relation(fields: [userId], references: [id]) 

  lastUpdated DateTime @updatedAt
  cartItems CartItem[]
  notes String?

}

model CartItem{
  id String @id @default(uuid())
  cartId String
  productId String
  name String
  price Decimal
  compareAt Decimal?
  quantity Int
  
  cart Cart @relation(fields: [cartId], references: [id])
  
}